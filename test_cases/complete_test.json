  "screens": [
    {
      "id": "home",
      "name": "Home",
      "route": "/",
      "is_home": true,
      "components": [
        {
          "type": "Scaffold",
          "children": [
            {
              "type": "AppBar",
              "props": {
                "title": "Home Screen",
                "backgroundColor": "#6200EE",
                "elevation": 4
              }
            },
            {
              "type": "Center",
              "children": [
                {
                  "type": "Column",
                  "props": {
                    "mainAxisAlignment": "center",
                    "crossAxisAlignment": "center"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "text": "Welcome to Flutter Builder",
                        "fontSize": 24,
                        "color": "#000000",
                        "fontWeight": "bold"
                      }
                    },
                    {
                      "type": "SizedBox",
                      "props": {
                        "height": 20
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "text": "Go to Profile",
                        "onPress": "handlePress"
                      }
                    },
                    {
                      "type": "SizedBox",
                      "props": {
                        "height": 10
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "text": "Go to Settings",
                        "onPress": "handleClick"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
