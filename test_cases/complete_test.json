                              "text": "Setting Item",
                              "fontSize": 16
                            }
                          },
                          {
                            "type": "Icon",
                            "props": {
                              "icon": "arrow_forward_ios",
                              "size": 20
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
