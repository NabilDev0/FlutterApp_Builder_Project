    {
      "id": "settings",
      "name": "Settings",
      "route": "/settings",
      "is_home": false,
      "components": [
        {
          "type": "Scaffold",
          "children": [
            {
              "type": "AppBar",
              "props": {
                "title": "Settings"
              }
            },
            {
              "type": "ListView",
              "props": {
                "itemCount": 5
              },
              "itemTemplate": {
                "type": "Card",
                "children": [
                  {
                    "type": "Padding",
                    "props": {
                      "padding": 12
                    },
                    "children": [
                      {
                        "type": "Row",
                        "props": {
